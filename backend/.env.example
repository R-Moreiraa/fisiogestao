# Configurações do Backend - FisioGestão SaaS
APP_NAME="FisioGestão SaaS"
APP_ENV="local"
APP_DEBUG=true
APP_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# JWT Secret para autenticação de tokens seguros
JWT_SECRET="fisio-jwt-super-secret-key-change-in-production-2025"

# Upstash Redis REST API
# Se não preenchido, o backend utiliza persistência estruturada local em backend/storage/redis_data.json
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

